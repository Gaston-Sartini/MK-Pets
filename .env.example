# ─────────────────────────────────────────────────────────────────────────────
# MK-Pets — variables de entorno
# Copiar a .env.local para desarrollo. En producción se cargan en el panel del
# hosting (Netlify → Site configuration → Environment variables).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# La anon key es pública por diseño: lo que protege los datos es RLS
# (supabase/migrations/*_security_hardening.sql).
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."

# ── Base de datos (Prisma) ───────────────────────────────────────────────────
# IMPORTANTE: en producción usar SIEMPRE el pooler (aws-1-sa-east-1.pooler...).
# El host directo db.[ref].supabase.co solo funciona por IPv6 y Netlify/Vercel
# son IPv4: con el host directo el sitio no puede crear pedidos.
# Copiar las URLs exactas desde Supabase → Connect → ORMs → Prisma.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Sitio ────────────────────────────────────────────────────────────────────
# URL pública, sin barra final. Se usa en los links de MercadoPago y de WhatsApp.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# WhatsApp de la tienda (formato internacional sin +). Opcional.
# NEXT_PUBLIC_SHOP_WHATSAPP="5491166698395"

# ── MercadoPago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN="APP_USR-..."
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."
# "Clave secreta" de Tus integraciones → Webhooks. Sin este valor el webhook
# rechaza todas las notificaciones (fail-closed).
MP_WEBHOOK_SECRET=""

# ── Chat vendedor (IA) ───────────────────────────────────────────────────────
# Motor propio: cualquier API compatible con OpenAI. Cambiar de proveedor o de
# modelo es cambiar estas variables, sin tocar código.
#   Groq:   https://api.groq.com/openai/v1                           (openai/gpt-oss-120b)
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai  (gemini-3.5-flash-lite)
#   OpenAI: https://api.openai.com/v1
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY=""
LLM_MODEL="openai/gpt-oss-120b"
# Solo para modelos con razonamiento (gpt-oss): "low" responde más rápido.
LLM_REASONING_EFFORT="low"

# Alternativa: chat vía n8n (requiere n8n 24/7 accesible desde internet).
# CHAT_ENGINE="n8n"
# CHAT_VERSION="v2"
# N8N_WEBHOOK_URL="https://n8n.tu-dominio.com/webhook/mk-pets-chat-v2"

# ── WhatsApp al cliente cuando hace un pedido ────────────────────────────────
# Opción A (recomendada): el sitio le habla directo a Evolution API.
# EVOLUTION_API_URL="https://wa.tu-dominio.com"
# EVOLUTION_API_KEY=""
# EVOLUTION_INSTANCE="mi-bot"

# Opción B: vía n8n (workflow infra/n8n/workflow-whatsapp-pedido.json).
# N8N_ORDER_WEBHOOK_URL="http://localhost:5678/webhook/mkpets-pedido"
# Secreto compartido con n8n (allá va como MKPETS_WEBHOOK_SECRET).
# N8N_WEBHOOK_SECRET=""

# Alias para transferencias. Si está, se incluye en el WhatsApp de pedidos
# con pago al recibir.
# TRANSFER_ALIAS=""
