# Supabase (HTTPS REST API — usado por el chat y otros runtimes serverless)
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."

# Base de datos (Supabase)
# Para Netlify/Lambdas, OBLIGATORIO: pgbouncer=true & connection_limit=1
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# MercadoPago
MP_ACCESS_TOKEN="APP_USR-..."
MP_PUBLIC_KEY="APP_USR-..."
MP_WEBHOOK_SECRET="tu-secret-de-webhook"

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."

# Seguridad — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Admin
ADMIN_EMAIL="admin@mkpets.com"
ADMIN_PASSWORD_HASH=""

# Chat (Typebot self-hosted — legacy, ya no se usa)
NEXT_PUBLIC_TYPEBOT_URL="http://localhost:8081"
NEXT_PUBLIC_TYPEBOT_FLOW="mk-pets-vendedor-mg7tvvl"

# Versión del bot de chat:
#   v1 = routing por regex (rápido, menos smart)
#   v2 = LLM Understand + reply conversacional argentino (default)
CHAT_VERSION="v2"

# Override total del endpoint del webhook (opcional)
# N8N_WEBHOOK_URL="http://localhost:5678/webhook/mk-pets-chat-v2"
